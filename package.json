{
  "name": "hotel-canino-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "npm run lint && npm run test:run && npm run build",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:conversation": "tsx scripts/conversation-e2e-smoke.ts",
    "smoke:conversation:sheets-real": "tsx scripts/conversation-sheets-real-smoke.ts",
    "conversations:reset": "tsx scripts/conversations-reset.ts",
    "reminders:reservation-prearrival": "node scripts/reservation-prearrival-reminders.mjs",
    "followups:post-stay": "node scripts/post-stay-followups.mjs",
    "jobs:dispatch-scheduled-messages": "node scripts/dispatch-scheduled-messages.mjs",
    "docker:build": "docker build -t hotel-canino-demo:local .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local hotel-canino-demo:local",
    "smoke:docker": "node scripts/smoke-docker.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:postgres": "node scripts/run-postgres-migrations.mjs",
    "db:check:postgres": "node scripts/check-postgres-schema.mjs",
    "db:setup": "npm run db:migrate",
    "easypanel:check": "node scripts/check-easypanel-env.mjs",
    "hotel:conversations:seed": "tsx scripts/hotel-conversations-seed.ts",
    "hotel:email:poll": "tsx scripts/hotel-email-poll.ts",
    "hotel:sheet:init": "tsx scripts/hotel-sheet-init.ts",
    "hotel:clients:ensure": "tsx scripts/hotel-clients-ensure.ts",
    "hotel:clients:import": "tsx scripts/hotel-clients-import.ts",
    "hotel:clients:import:pdf": "tsx scripts/hotel-clients-import-pdf.ts",
    "clients:pets:plan": "node scripts/clients-pets-import-plan.mjs",
    "clients:ensure-sheet": "tsx scripts/hotel-clients-ensure.ts",
    "clients:import": "tsx scripts/hotel-clients-import.ts",
    "clients:import:pdf": "tsx scripts/hotel-clients-import-pdf.ts",
    "hotel:reminders:dispatch": "tsx scripts/hotel-reminders-dispatch.ts",
    "hotel:worker": "tsx scripts/hotel-worker.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.2.17",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "next": "16.2.1",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "postal-mime": "^2.7.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  }
}
