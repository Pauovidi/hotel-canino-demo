# Panel admin
HOTEL_PANEL_USERNAME=
HOTEL_PANEL_PASSWORD=
HOTEL_PANEL_ALLOW_LOCAL_AUTH_BYPASS=

# App y persistencia
APP_BASE_URL=
APP_ENV=development
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1
HOTEL_RUNTIME_TARGET=local
HOTEL_TIMEZONE=Europe/Madrid
HOTEL_PERSISTENCE_PROVIDER=file-volume
HOTEL_CONVERSATIONS_STORE=file-volume
HOTEL_CLIENTS_SOURCE=google_sheets
HOTEL_RESERVATIONS_SOURCE=google_sheets
HOTEL_ENTRY_LOG_SOURCE=google_sheets
HOTEL_SHEETS_WRITE_ENABLED=false
HOTEL_SHEETS_DRY_RUN=true
HOTEL_LLM_NLU_ENABLED=false
HOTEL_LLM_NLU_SHADOW=true
HOTEL_LLM_NLU_DECISION_MODE=shadow
# Para activar NLU assistive seguro manualmente en EasyPanel:
# HOTEL_LLM_NLU_ENABLED=true
# HOTEL_LLM_NLU_DECISION_MODE=assistive_safe
# HOTEL_LLM_NLU_SHADOW=false
DATABASE_URL=
HOTEL_FILE_STORE_DIR=/data
HOTEL_CONVERSATIONS_STORE_PATH=
HOTEL_CONVERSATIONS_STORE_DIR=
HOTEL_CONVERSATIONS_DEMO_SEED=
HOTEL_DEMO_STORE_PATH=
HOTEL_DOMAIN_STORE_PATH=
HOTEL_REMINDERS_STORE_PATH=
HOTEL_EMAIL_STATE_STORE_PATH=

# Twilio WhatsApp Sandbox/real
HOTEL_CONVERSATIONS_MOCK_TWILIO=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_PROVIDER_MODE=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_WEBHOOK_AUTH_ENABLED=true
TWILIO_VALIDATE_SIGNATURES=
TWILIO_STATUS_CALLBACK_URL=

# OpenAI / structured NLU (off by default until a later branch activates it)
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Sheets real
HOTEL_USE_GOOGLE_SHEETS_REAL=
HOTEL_GOOGLE_SHEETS_SPREADSHEET_ID=
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
HOTEL_CLIENTS_SHEET_NAME=CLIENTES
HOTEL_CLIENTS_CACHE_TTL_MS=300000
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
HOTEL_GOOGLE_SHEETS_PRIVATE_KEY=

# Email IMAP real
HOTEL_USE_MOCK_EMAIL_INPUT=true
HOTEL_EMAIL_IMAP_HOST=
HOTEL_EMAIL_IMAP_PORT=993
HOTEL_EMAIL_IMAP_SECURE=true
HOTEL_EMAIL_IMAP_USER=
HOTEL_EMAIL_IMAP_PASSWORD=
HOTEL_EMAIL_IMAP_MAILBOX=INBOX

# Recordatorios
HOTEL_USE_REMINDERS_REAL=false
HOTEL_REMINDER_WEBHOOK_URL=
HOTEL_REMINDER_LEAD_HOURS=120

# Peticiones cliente: contrato, confirmaciones, recordatorios y bienvenida
HOTEL_CONTRACT_URL=https://somosmuyperros.com/contrato-de-admision-e-ingreso/
HOTEL_CONTRACT_ACCEPTANCE_REQUIRED=true
HOTEL_CONFIRMATION_TEMPLATE_ENABLED=true
HOTEL_RESERVATION_REMINDERS_ENABLED=false
HOTEL_RESERVATION_REMINDERS_DRY_RUN=true
HOTEL_RESERVATION_REMINDER_ENABLED=false
HOTEL_RESERVATION_REMINDER_DRY_RUN=true
HOTEL_RESERVATION_REMINDER_DAYS_BEFORE=5
HOTEL_POST_STAY_FOLLOWUPS_ENABLED=false
HOTEL_POST_STAY_FOLLOWUPS_DRY_RUN=true
HOTEL_POST_STAY_FOLLOWUP_ENABLED=false
HOTEL_POST_STAY_FOLLOWUP_DRY_RUN=true
HOTEL_POST_STAY_FOLLOWUP_DAYS_AFTER=1
HOTEL_POST_STAY_FOLLOWUP_ONLY_NEW_CLIENTS=true
HOTEL_SCHEDULED_MESSAGES_ENABLED=false
HOTEL_SCHEDULED_MESSAGES_DRY_RUN=true
HOTEL_BATH_OFFER_ENABLED=false
HOTEL_BATH_OFFER_DRY_RUN=true
HOTEL_BATH_OFFER_DELAY_MINUTES=2
HOTEL_WAITLIST_ENABLED=false
HOTEL_WAITLIST_DRY_RUN=true
HOTEL_WELCOME_DOG_PERSONA_ENABLED=false
HOTEL_WELCOME_STICKER_DRY_RUN=true
HOTEL_WELCOME_STICKER_MEDIA_URL=
HOTEL_TEMPLATE_PREVIEW_ENABLED=false
HOTEL_TEMPLATE_PREVIEW_ALLOW_IN_SANDBOX=true
HOTEL_TEMPLATE_PREVIEW_ADMIN_ONLY=true
HOTEL_TEMPLATE_PREVIEW_SAMPLE_CLIENT_NAME=Pau
HOTEL_TEMPLATE_PREVIEW_SAMPLE_PETS=PIPO
HOTEL_TEMPLATE_PREVIEW_SAMPLE_PRICE=30€
HOTEL_TEMPLATE_PREVIEW_SAMPLE_ENTRY=Viernes, 25 de Diciembre de 2026 a las 10:00
HOTEL_TEMPLATE_PREVIEW_SAMPLE_EXIT=Sábado, 26 de Diciembre de 2026 a las 10:00
