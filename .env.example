# Panel admin
HOTEL_PANEL_USERNAME=
HOTEL_PANEL_PASSWORD=
HOTEL_PANEL_ALLOW_LOCAL_AUTH_BYPASS=

# App y persistencia
APP_BASE_URL=
APP_ENV=development
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1
HOTEL_RUNTIME_TARGET=local
HOTEL_TIMEZONE=Europe/Madrid
HOTEL_PERSISTENCE_PROVIDER=file-volume
HOTEL_CONVERSATIONS_STORE=file-volume
HOTEL_CLIENTS_SOURCE=google_sheets
HOTEL_RESERVATIONS_SOURCE=google_sheets
HOTEL_ENTRY_LOG_SOURCE=google_sheets
HOTEL_SHEETS_WRITE_ENABLED=false
HOTEL_SHEETS_DRY_RUN=true
HOTEL_LLM_NLU_ENABLED=false
HOTEL_LLM_NLU_SHADOW=true
HOTEL_LLM_NLU_DECISION_MODE=shadow
DATABASE_URL=
HOTEL_FILE_STORE_DIR=/data
HOTEL_CONVERSATIONS_STORE_PATH=
HOTEL_CONVERSATIONS_STORE_DIR=
HOTEL_CONVERSATIONS_DEMO_SEED=
HOTEL_DEMO_STORE_PATH=
HOTEL_DOMAIN_STORE_PATH=
HOTEL_REMINDERS_STORE_PATH=
HOTEL_EMAIL_STATE_STORE_PATH=

# Twilio WhatsApp Sandbox/real
HOTEL_CONVERSATIONS_MOCK_TWILIO=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_PROVIDER_MODE=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_WEBHOOK_AUTH_ENABLED=true
TWILIO_VALIDATE_SIGNATURES=
TWILIO_STATUS_CALLBACK_URL=

# OpenAI / structured NLU (off by default until a later branch activates it)
OPENAI_API_KEY=

# Google Sheets real
HOTEL_USE_GOOGLE_SHEETS_REAL=
HOTEL_GOOGLE_SHEETS_SPREADSHEET_ID=
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
HOTEL_CLIENTS_SHEET_NAME=CLIENTES
HOTEL_CLIENTS_CACHE_TTL_MS=300000
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
HOTEL_GOOGLE_SHEETS_PRIVATE_KEY=

# Email IMAP real
HOTEL_USE_MOCK_EMAIL_INPUT=true
HOTEL_EMAIL_IMAP_HOST=
HOTEL_EMAIL_IMAP_PORT=993
HOTEL_EMAIL_IMAP_SECURE=true
HOTEL_EMAIL_IMAP_USER=
HOTEL_EMAIL_IMAP_PASSWORD=
HOTEL_EMAIL_IMAP_MAILBOX=INBOX

# Recordatorios
HOTEL_USE_REMINDERS_REAL=false
HOTEL_REMINDER_WEBHOOK_URL=
HOTEL_REMINDER_LEAD_HOURS=120
